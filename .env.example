# Copy to .env and fill in. Never commit the real file.

# ── Application ───────────────────────────────────────────────────────────────
PROJECT_NAME="Polymind"
API_V1_STR="/api/v1"
ENVIRONMENT=development          # development | staging | production
LOG_LEVEL=INFO
# Public origin of the web app: used for payment redirects, share links and
# password-reset emails.
FRONTEND_URL="http://localhost:5173"
# JSON array or comma-separated list
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"

# ── Security ──────────────────────────────────────────────────────────────────
# At least 32 characters: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=""
ALGORITHM="HS256"
# Clients refresh their token while in use, so this is the idle timeout.
ACCESS_TOKEN_EXPIRE_MINUTES=240
PASSWORD_RESET_TOKEN_MINUTES=30

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql+asyncpg://user:password@host:5432/dbname"
# Keep true behind PgBouncer / the Supabase pooler; set false for a direct connection
DB_USE_NULL_POOL=true
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ── Redis (cache, rate limits, reset tokens, Celery broker) ───────────────────
REDIS_URL="redis://localhost:6379/0"
REDIS_MAX_CONNECTIONS=20
CACHE_TTL_SECONDS=3600

# ── Chat ──────────────────────────────────────────────────────────────────────
CHAT_HISTORY_LIMIT=24            # messages of context sent to the model
CHAT_STREAM_TIMEOUT_SECONDS=300
CHAT_TITLE_GENERATION=true       # name new chats with a cheap model (not billed)
MAX_UPLOAD_SIZE_MB=10
MAX_UPLOAD_FILES=5

# ── Abuse protection ──────────────────────────────────────────────────────────
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_SIGNUP_PER_HOUR=20
RATE_LIMIT_MEDIA_PER_HOUR=60
RATE_LIMIT_UPLOADS_PER_HOUR=120

# ── Auth provider ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=""

# ── LLM providers (each one is optional; a missing key disables that provider) ─
OPENAI_API_KEY=""                # GPT-5.5 family, GPT Image 2, OpenAI voices
ANTHROPIC_API_KEY=""             # Claude Fable 5.1, Opus 5, Sonnet 5, Haiku 4.5
GOOGLE_API_KEY=""                # Gemini 3.x, Nano Banana image models
DID_API_KEY=""                   # format: username:password (avatar video)
GOOGLE_APPLICATION_CREDENTIALS="google_credentials.json"   # Google Cloud voices

# ── Object storage (Cloudflare R2 or any S3-compatible service) ───────────────
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_BUCKET_NAME=""
STORAGE_REGION="auto"
STORAGE_PUBLIC_URL=""            # public base URL for objects in the bucket

# ── Payments ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# ── Email (password resets). Optional: without SMTP the link is logged. ───────
SMTP_HOST=""
SMTP_PORT=587
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_USE_TLS=true
SMTP_USE_SSL=false
EMAIL_FROM="Polymind <no-reply@example.com>"

# ── Media generation ──────────────────────────────────────────────────────────
DID_POLL_INTERVAL_SECONDS=5
DID_POLL_MAX_ATTEMPTS=100

# ── Development only ──────────────────────────────────────────────────────────
# Enables POST /users/topup, which mints free credits. Refused in production.
ALLOW_DEV_TOPUP=false
