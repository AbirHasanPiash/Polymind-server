# Copy to .env and fill in. Never commit the real file.

# ── Application ───────────────────────────────────────────────────────────────
PROJECT_NAME="Multi-Model-AI"
API_V1_STR="/api/v1"
ENVIRONMENT=development          # development | staging | production
LOG_LEVEL=INFO
FRONTEND_URL="http://localhost:5173"
# JSON array or comma-separated list
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"

# ── Security ──────────────────────────────────────────────────────────────────
# At least 32 characters: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=""
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql+asyncpg://user:password@host:5432/dbname"
# Keep true behind PgBouncer / the Supabase pooler; set false for a direct connection
DB_USE_NULL_POOL=true
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ── Redis (cache + Celery broker) ─────────────────────────────────────────────
REDIS_URL="redis://localhost:6379/0"
REDIS_MAX_CONNECTIONS=20
CACHE_TTL_SECONDS=3600

# ── Chat limits ───────────────────────────────────────────────────────────────
CHAT_HISTORY_LIMIT=10
CHAT_STREAM_TIMEOUT_SECONDS=120
MAX_UPLOAD_SIZE_MB=10
MAX_UPLOAD_FILES=5

# ── Auth provider ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=""

# ── LLM providers (each one is optional; a missing key disables that provider) ─
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GOOGLE_API_KEY=""
DID_API_KEY=""                   # format: username:password
GOOGLE_APPLICATION_CREDENTIALS="google_credentials.json"

# ── Object storage (Cloudflare R2 or any S3-compatible service) ───────────────
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_BUCKET_NAME=""
STORAGE_REGION="auto"
STORAGE_PUBLIC_URL=""            # public base URL for objects in the bucket

# ── Payments ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# ── Media generation ──────────────────────────────────────────────────────────
DID_POLL_INTERVAL_SECONDS=5
DID_POLL_MAX_ATTEMPTS=100

# ── Development only ──────────────────────────────────────────────────────────
# Enables POST /users/topup, which mints free credits. Refused in production.
ALLOW_DEV_TOPUP=false
